# Copy this file to `.env.local` for local development.
# In production, set the same variables in Vercel → Settings → Environment Variables.

# --- Founder access (optional) ---
# When set, founder API actions require the key or a signed-in session.
FOUNDER_KEY=
# Optional extra secret for session cookies (defaults to FOUNDER_KEY).
FOUNDER_SESSION_SECRET=

# --- Email alerts (optional) ---
# Get a free API key at https://resend.com
RESEND_API_KEY=
# Where challenge and waitlist alerts are sent.
FOUNDER_NOTIFY_EMAIL=
# Optional custom from address after verifying a domain in Resend.
# RESEND_FROM_EMAIL=Challenge My Beliefs <notify@yourdomain.com>

# --- Public site URL (optional) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (recommended for production). See SUPABASE.md ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
# Legacy names Vercel may inject instead:
# SUPABASE_URL=
# POSTGRES_URL_NON_POOLING=

# --- Vercel Blob (fallback if Supabase is not set) ---
# BLOB_READ_WRITE_TOKEN=

# --- Cursor auto git push (optional) ---
# CURSOR_AUTO_GIT_PUSH=0
