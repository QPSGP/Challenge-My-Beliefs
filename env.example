# Optional. When set, founder actions require the x-founder-key header to match.
FOUNDER_KEY=

# Supabase (recommended for production). See SUPABASE.md
# Vercel Marketplace may set NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# NEXT_PUBLIC_SUPABASE_URL=

# Vercel Blob (fallback if Supabase is not set). Added automatically when Blob is connected.
# BLOB_READ_WRITE_TOKEN=

# Optional. Set to 0 to disable Cursor stop-hook auto git push.
# CURSOR_AUTO_GIT_PUSH=0
